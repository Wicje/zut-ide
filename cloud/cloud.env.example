# Copy to cloud/cloud.env on the VPS (never commit real values).
# The browser needs only VITE_* vars at build time; everything below stays server-side.

# Supabase (same project the frontend uses)
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Service-role key: lets the server write zut_usage_meter rows (RLS-bypassed).
# Create at Supabase Dashboard → Project Settings → API → service_role.
# Never put this in VITE_* vars or the frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Agent defaults
ZUT_AGENT_MODEL=openrouter/google/gemini-2.5-flash
ZUT_AGENT_AUTO=1
ZUT_AGENT_TIMEOUT_MS=120000
# Max parallel agent turns (rest queue up to 90s, then 429). 2 is right for 4GB.
ZUT_AGENT_CONCURRENCY=2
# Max bytes per user project on server disk.
ZUT_WORKSPACE_MAX_MB=50

# Program execution (/run for Python/Go on weak devices)
ZUT_RUN_TIMEOUT_MS=8000
ZUT_RUN_MAX_OUTPUT=262144
ZUT_RATE_RUN_MIN=20

# Quotas (broker enforces; browser mirrors for honest UI)
ZUT_MONTHLY_AGENT_CAP=50
ZUT_RATE_BUILD_MIN=30
ZUT_RATE_AGENT_MIN=10
ZUT_DAILY_RUN_CAP=50
ZUT_MAX_SESSION_MS=7200000
ZUT_MAX_LIVE_SESSIONS_PER_USER=1
# Payer: owner-subsidized (higher caps) vs user-quota (lower caps + upsell).
# Pilot: start low, dashboard cost/run, raise only with data.
ZUT_PAYER_MODEL=owner

# Cells + Mudbase (server-side only — never VITE_* / browser)
# MUDBASE_URL=https://api.mudbase.dev
# MUDBASE_PROJECT_ID=
# MUDBASE_API_KEY=(project key, broker only)
# CELLS_API_KEY=(broker only, 60s terminal tokens minted per request)
# CELLS_DEFAULT_SIZE=micro
# CELLS_AUTOSUSPEND_MIN=5

# Caddy
CLOUD_HOST=cloud.example.com
ACME_EMAIL=you@example.com
# REQUIRED in production: the exact origin(s) of your frontend, comma-separated.
# The default "*" lets any site spend your agent quota — never ship with it.
# Example: CORS_ORIGIN=https://wicje.github.io
CORS_ORIGIN=https://YOUR_PAGES_DOMAIN
