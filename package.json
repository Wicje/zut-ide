{
  "name": "zut-ide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bridge": "node scripts/file-bridge.mjs",
    "runtime": "node runtime/server.mjs",
    "cloud": "node cloud/server.mjs",
    "dev:opencode": "ZUT_WORKSPACE=${ZUT_WORKSPACE:-$HOME/.zut-projects/default} && mkdir -p \"$ZUT_WORKSPACE\" && cd \"$ZUT_WORKSPACE\" && opencode serve --port 4096 --hostname 127.0.0.1",
    "dev:all": "npm run dev & npm run runtime & npm run dev:bridge & npm run dev:opencode",
    "dev:server": "npm run runtime & npm run dev:bridge & npm run dev:opencode",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/standalone": "^7.25.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "esbuild": "^0.21.5",
    "esbuild-wasm": "^0.23.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.46.0",
    "monaco-editor": "^0.51.0",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__standalone": "^7.1.7",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
