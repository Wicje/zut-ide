{
  "name": "zut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bridge": "node scripts/file-bridge.mjs",
    "runtime": "node runtime/server.mjs",
    "broker": "node broker/server.mjs",
    "cloud": "node cloud/server.mjs",
    "host": "node host/server.mjs",
    "dev:opencode": "ZUT_WORKSPACE=${ZUT_WORKSPACE:-$HOME/.zut-projects/default} && mkdir -p \"$ZUT_WORKSPACE\" && cd \"$ZUT_WORKSPACE\" && opencode serve --port 4096 --hostname 127.0.0.1",
    "dev:all": "npm run dev & npm run cloud",
    "dev:server": "npm run cloud",
    "build": "tsc -b && vite build",
    "build:vercel": "npm run build && node scripts/assemble-vercel.mjs",
    "preview": "vite preview",
    "term": "node terminal/bin/zut-term.mjs",
    "term:local": "node scripts/term-local.mjs",
    "local": "node scripts/local-stack.mjs up",
    "local:down": "node scripts/local-stack.mjs down",
    "local:status": "node scripts/local-stack.mjs status",
    "local:logs": "node scripts/local-stack.mjs logs",
    "term:build": "npm --prefix terminal run build",
    "term:setup": "npm --prefix terminal install && npm --prefix terminal run build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "health": "node scripts/health-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^2.28.0",
    "@monaco-editor/react": "^4.6.0",
    "@sentry/react": "^11.6.0",
    "@supabase/supabase-js": "^2.45.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.21.5",
    "esbuild-wasm": "^0.23.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "monaco-editor": "^0.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
