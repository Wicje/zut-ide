# zut-cloud (recommended) — ONE url for builds + cloud agent.
# Point at your VPS: https://cloud.example.com
# Local dev: http://localhost:8787 (npm run cloud)
VITE_CLOUD_URL=

# Supabase (optional — the app runs fine without it in local-only mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mudbase serverless API (optional — powers the Deploy → Serverless tab).
#
# Recommended: run the key behind the zut-runtime proxy so the browser never
# sees it. Start the service with ZUT_MUDBASE_API_KEY / ZUT_MUDBASE_PROJECT_ID
# set, then point the IDE at it:
VITE_MUDBASE_PROXY_URL=http://localhost:8787/mudbase
#
# Personal/local use only: put a *functions-scoped* key directly in the
# browser bundle. Mint it at https://www.mudbase.dev/console (Settings →
# API Keys) with ONLY functions create/read/update/delete on one project,
# then revoke any full-access key. Never commit a real key.
VITE_MUDBASE_BASE_URL=https://api.mudbase.dev
VITE_MUDBASE_API_KEY=
VITE_MUDBASE_PROJECT_ID=

# Run broker (optional, recommended for hosted use). ONE url for runs +
# terminal + preview. Browser sends only the user's Mudbase token + workspace
# id; broker holds Cells + Mudbase service keys server-side.
# Local dev: http://localhost:8787. Leave blank to build/run locally (free).
VITE_RUNTIME_URL=
# Never ship a static broker token in the browser. Auth is the signed-in
# user's token per request. Static tokens are server-to-server only.
VITE_RUNTIME_TOKEN=

# Pilot quotas (browser mirrors; broker enforces). Payer decides:
# owner-subsidized (higher daily cap) vs user quota (lower cap + upsell).
VITE_DAILY_RUN_CAP=50

# opencode AI server. Runs the coding agent — put it on a server so the agent's
# compute and file access never touch the student's laptop. api keys never
# reach the browser.
VITE_OPENCODE_URL=http://127.0.0.1:4096

# opencode file bridge. Syncs the IDE's virtual project to disk so the agent
# can edit real files. Start with `npm run dev:bridge`.
VITE_OPENCODE_BRIDGE_URL=http://127.0.0.1:4331
# Only needed when the bridge is started with ZUT_BRIDGE_TOKEN.
VITE_OPENCODE_BRIDGE_TOKEN=

# Error tracking (optional — Sentry SaaS free tier; app runs fine blank).
VITE_SENTRY_DSN=