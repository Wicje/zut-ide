# Supabase (optional — the app runs fine without it in local-only mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# opencode AI server (local). The opencode server reads this from your
# opencode config; api keys never reach the browser.
VITE_OPENCODE_URL=http://127.0.0.1:4096

# opencode file bridge (local). Syncs the IDE's virtual project to disk so
# the opencode agent can edit real files. Start with `npm run dev:bridge`.
VITE_OPENCODE_BRIDGE_URL=http://127.0.0.1:4331