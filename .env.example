# zut-cloud (recommended) — ONE url for builds + cloud agent.
# Point at your VPS: https://cloud.example.com
# Local dev: http://localhost:8787 (npm run cloud)
VITE_CLOUD_URL=

# Supabase (optional — the app runs fine without it in local-only mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mudbase account auth (optional). Only the public project id belongs in the
# browser. The API key is a server secret: put it on the broker/runtime as
# ZUT_MUDBASE_API_KEY and never expose it through a VITE_* variable (Vite
# inlines those into the browser bundle).
VITE_MUDBASE_PROJECT_ID=
# Optional: self-hosted Mudbase API base (defaults to https://api.mudbase.dev).
VITE_MUDBASE_URL=

# Run broker (optional, recommended for hosted use). ONE url for runs +
# terminal + preview. Browser sends only the signed-in user's token +
# workspace id; the broker holds Cells/Mudbase service keys server-side.
# Local dev: http://localhost:8787 (npm run broker). Leave blank to build/run
# locally (free).
VITE_BROKER_URL=
# Legacy alias, still read for compatibility. Prefer VITE_BROKER_URL.
# VITE_RUNTIME_URL=http://localhost:8787

# Quotas are enforced server-side by the broker (ZUT_DAILY_RUN_CAP,
# ZUT_RATE_RUN_MIN). No browser-side cap to configure.

# opencode AI server. Runs the coding agent — put it on a server so the agent's
# compute and file access never touch the user's device. API keys never
# reach the browser.
VITE_OPENCODE_URL=http://127.0.0.1:4096

# opencode file bridge. Syncs the IDE's virtual project to disk so the agent
# can edit real files. Start with `npm run dev:bridge`.
VITE_OPENCODE_BRIDGE_URL=http://127.0.0.1:4331
# Only needed when the bridge is started with ZUT_BRIDGE_TOKEN.
VITE_OPENCODE_BRIDGE_TOKEN=

# zut-host (self-hosted workspace + real terminal + git).
# Run `npm run host` on the machine that should own the files. On the same
# machine the defaults work; set a token before binding to a LAN address.
#   ZUT_WORKSPACE=~/.zut-projects/default
#   ZUT_HOST_TOKEN=<long random string>
#   ZUT_HOST_MODE=selfhost|hosted
#   ZUT_TERMINAL_JAIL=1   (hosted default: sandboxed env)
#   CORS_ORIGIN=https://your-ide.example  (required for non-loopback pages)
# The browser token is a shared host secret, not a user identity. Prefer the
# "Connect host" dialog (localStorage); VITE_ZUT_HOST_URL is fine for a fixed
# deployment. Never set VITE_ZUT_HOST_TOKEN on an exposed host — Vite inlines it
# into the public bundle. Leave it blank and let each browser enter its own.
VITE_ZUT_HOST_URL=
VITE_ZUT_HOST_TOKEN=

# Error tracking (optional — Sentry SaaS free tier; app runs fine blank).
VITE_SENTRY_DSN=